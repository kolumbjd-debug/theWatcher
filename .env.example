# Helius RPC/WebSocket provider
HELIUS_API_KEY=your_helius_api_key_here

# Supabase project credentials
# SUPABASE_KEY must be the service_role secret key (Project Settings > API),
# not the anon/publishable key — RLS is enabled on price_gaps with no policies,
# so only service_role can read/write it. Never expose this key client-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

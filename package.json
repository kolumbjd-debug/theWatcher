{
  "name": "solana-dex-price-gap-scanner",
  "version": "0.1.0",
  "description": "Read-only Solana DEX price-gap monitor (Raydium vs Orca) — logs price gaps to Supabase for later analysis.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "archive": "ts-node --transpile-only src/archive.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@orca-so/whirlpools-sdk": "^0.22.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.95.3",
    "@supabase/supabase-js": "^2.45.4",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
